# DEEPSEEK_API_KEY is read only by the Node/Express server.
# Do not expose it in frontend code or Vite build-time variables.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
DEEPSEEK_MODEL="deepseek-chat"
PORT="3201"
DATABASE_URL="postgres://zhensuan_app:CHANGE_ME@127.0.0.1:5432/zhensuan"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_BEFORE_USE"

CUSTOMER_AUTH_MOCKS_ENABLED="true"
SMS_CODE_TTL_SECONDS="300"
SMS_SEND_COOLDOWN_SECONDS="60"
SMS_OTP_MAX_ATTEMPTS="5"
QR_LOGIN_TTL_SECONDS="180"
WECHAT_MINIPROGRAM_APP_ID="wxc4ed7c07ce86326c"
WECHAT_MINIPROGRAM_SECRET=""
WECHAT_CODE2SESSION_URL="https://api.weixin.qq.com/sns/jscode2session"
WECHAT_LOGIN_MOCKS_ENABLED="false"

# ===== WeChat Pay (JSAPI v3) =====
# Set WECHAT_PAY_ENABLED="true" ONLY after all of the following are filled in,
# otherwise the payment endpoints return 503 (disabled / not configured).
WECHAT_PAY_ENABLED="false"
# Merchant ID (商户号), from 微信支付商户平台 -> 账户中心 -> 商户信息
WECHAT_PAY_MCH_ID=""
# API v3 key (32 bytes). 微信支付商户平台 -> API安全 -> 设置APIv3密钥
WECHAT_PAY_API_V3_KEY=""
# 商户API证书序列号 (serial number). 微信支付商户平台 -> API安全 -> 管理证书
WECHAT_PAY_CERT_SERIAL_NO=""
# Absolute path to the merchant private key PEM (apiclient_key.pem) on the server.
WECHAT_PAY_PRIVATE_KEY_PATH=""
# Public callback URL WeChat will POST payment results to.
# Must be reachable from WeChat servers and use HTTPS. Override with your deployed domain.
WECHAT_PAY_NOTIFY_URL="https://www.goye.cc/destiny-api/payments/wechat/notify"
# WeChat Pay API base URL (normally no need to change).
WECHAT_PAY_API_BASE_URL="https://api.mch.weixin.qq.com"

TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SIGN_NAME="甄好算"
TENCENT_SMS_LOGIN_TEMPLATE_ID=""
TENCENT_SMS_BIND_TEMPLATE_ID=""

NEO4J_URI="bolt://127.0.0.1:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="CHANGE_ME"
NEO4J_DATABASE="neo4j"
MEDUSA_HEALTH_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
