/* Zhensuan mini-program design system.
 * Web palette reference:
 * paper #FDFCF8, surface #fbf9fb, report #F9FAFB,
 * ink #1A2F4B, teal #4A7C77, gold #B89150, vermillion #C84B31.
 */

page {
  background: #fdfcf8;
  color: #1a2f4b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #fdfcf8;
}

.hero {
  padding: 18rpx 0 24rpx;
  text-align: left;
}

.brand {
  color: #b89150;
  font-size: 23rpx;
  letter-spacing: 0;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.title {
  color: #1a2f4b;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.28;
}

.subtitle {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.58;
  margin-top: 14rpx;
}

.section,
.zs-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.zs-card-accent {
  position: relative;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 26rpx 26rpx 26rpx 34rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.zs-card-accent::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #4a7c77;
}

.zs-card-accent.accent-red::before {
  background: #c84b31;
}

.zs-card-accent.accent-gold::before {
  background: #b89150;
}

.zs-card-teal {
  border-color: rgba(74, 124, 119, 0.28);
  background: rgba(74, 124, 119, 0.08);
}

.zs-card-gold {
  border-color: rgba(184, 145, 80, 0.35);
  background: rgba(184, 145, 80, 0.08);
}

.section-title {
  color: #1a2f4b;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 18rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  min-height: 78rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  color: #1a2f4b;
  background: #f9fafb;
  font-size: 30rpx;
}

.textarea {
  min-height: 168rpx;
  line-height: 1.6;
}

.form-help {
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 14rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip,
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  color: #1a2f4b;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
}

.chip.active,
.pill-teal {
  color: #ffffff;
  background: #4a7c77;
  border-color: #4a7c77;
}

.pill-gold {
  color: #1a2f4b;
  background: rgba(184, 145, 80, 0.12);
  border-color: rgba(184, 145, 80, 0.35);
}

.pill-red {
  color: #c84b31;
  background: rgba(200, 75, 49, 0.08);
  border-color: rgba(200, 75, 49, 0.28);
}

.primary-button,
.teal-button,
.secondary-button,
.ghost-button {
  min-height: 86rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button,
.teal-button {
  width: 100%;
  color: #ffffff;
  font-weight: 600;
}

.primary-button {
  background: #1a2f4b;
}

.teal-button {
  background: #4a7c77;
}

.secondary-button {
  border: 1rpx solid #e5e7eb;
  color: #1a2f4b;
  background: #ffffff;
}

.ghost-button {
  color: #4a7c77;
  background: transparent;
}

.notice {
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
  margin-top: 24rpx;
}

.empty {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}

.message {
  border-radius: 12rpx;
  background: rgba(74, 124, 119, 0.08);
  border: 1rpx solid rgba(74, 124, 119, 0.24);
  color: #4a7c77;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx 20rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}
