/* 商城页 — 深色玄学风 */

.store-page {
  background:
    radial-gradient(ellipse at 60% 0%, rgba(201, 168, 76, 0.07) 0%, transparent 50%),
    #0C0F1A;
}

/* ---- Hero ---- */
.store-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 0 32rpx;
}

.store-hero-icon {
  color: #C9A84C;
  font-size: 54rpx;
  opacity: 0.4;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ---- 权益状态栏 ---- */
.value-bar {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  margin-bottom: 20rpx;
}

.value-item {
  flex: 1;
  text-align: center;
}

.value-num {
  color: #C9A84C;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}

.value-level {
  font-size: 30rpx;
}

.value-label {
  color: #7E8BAA;
  font-size: 21rpx;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.value-sep {
  width: 1rpx;
  height: 56rpx;
  background: rgba(201, 168, 76, 0.15);
}

/* ---- 快捷操作 ---- */
.store-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.store-action-btn {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #13192B;
  border: 1rpx solid rgba(201, 168, 76, 0.15);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.store-action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.store-action-text {
  color: #7E8BAA;
  font-size: 26rpx;
  font-weight: 600;
}

/* ---- 收货地址块 ---- */
.address-block {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
}

.address-block-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-block-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.address-block-info {
  flex: 1;
  min-width: 0;
}

.address-label {
  color: #E8EAF0;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.address-detail {
  color: #7E8BAA;
  font-size: 22rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.address-change-btn {
  color: #C9A84C;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.3);
  border-radius: 999rpx;
}

/* ---- 商品列表 ---- */
.store-section-title {
  color: #7E8BAA;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.product-card-gold {
  background: linear-gradient(135deg, #1F1808 0%, #13192B 60%);
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.product-card-teal {
  background: linear-gradient(135deg, #081514 0%, #13192B 60%);
  border: 1rpx solid rgba(74, 124, 119, 0.3);
}

.product-card-inner {
  padding: 28rpx;
}

.product-top {
  margin-bottom: 14rpx;
}

.product-type-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.product-card-gold .product-type-badge {
  color: #C9A84C;
  background: rgba(201, 168, 76, 0.12);
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.product-card-teal .product-type-badge {
  color: #4A7C77;
  background: rgba(74, 124, 119, 0.12);
  border: 1rpx solid rgba(74, 124, 119, 0.3);
}

.product-name {
  color: #E8EAF0;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.product-desc {
  color: #7E8BAA;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.5;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.product-price {
  color: #7E8BAA;
  font-size: 22rpx;
}

.product-price-num {
  color: #C9A84C;
  font-size: 46rpx;
  font-weight: 800;
  margin-left: 4rpx;
}

/* 购买按钮：覆盖 TDesign primary 色为金色 */
.product-card-gold .t-button--primary {
  background: linear-gradient(135deg, #C9A84C, #8B6B2A) !important;
  color: #0C0F1A !important;
  border-color: transparent !important;
}

.product-card-teal .t-button--primary {
  background: #4A7C77 !important;
  color: #E8EAF0 !important;
  border-color: transparent !important;
}
