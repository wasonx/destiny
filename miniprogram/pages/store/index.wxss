.value-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}

.metric-label {
  color: #6b7280;
  font-size: 22rpx;
}

.metric-value {
  color: #1a2f4b;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.quick-button {
  min-height: 84rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 28rpx;
}

.product-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.product-name {
  color: #1a2f4b;
  font-size: 34rpx;
  font-weight: 700;
}

.product-sku,
.product-payload {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.product-price {
  color: #b89150;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

.product-card .primary-button {
  margin-top: 24rpx;
}

.empty {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}
