.value-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}

.metric-label {
  color: #6b7280;
  font-size: 22rpx;
}

.metric-value {
  color: #1a2f4b;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.quick-button {
  min-height: 84rpx;
}

.address-panel {
  margin-bottom: 24rpx;
}

.address-head {
  align-items: center;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
}

.address-title {
  color: #1a2f4b;
  font-size: 30rpx;
  font-weight: 700;
}

.address-desc {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.address-button {
  flex: 0 0 132rpx;
  min-height: 72rpx;
}

.address-picker,
.address-empty {
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 22rpx;
}

.address-label {
  color: #1a2f4b;
  font-size: 28rpx;
  font-weight: 700;
}

.address-detail,
.address-empty {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
}

.address-detail {
  margin-top: 8rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  margin-bottom: 0;
}

.product-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.product-name {
  color: #1a2f4b;
  font-size: 34rpx;
  font-weight: 700;
}

.product-sku,
.product-payload {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.product-type {
  margin-top: 12rpx;
}

.product-price {
  color: #b89150;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

.product-card .primary-button {
  margin-top: 24rpx;
}

.empty {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 80rpx 0;
  text-align: center;
}
