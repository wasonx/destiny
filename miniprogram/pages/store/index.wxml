<view class="page store-page">

  <!-- Hero -->
  <view class="store-hero">
    <view>
      <view class="brand">甄 好 算 · 商 城</view>
      <view class="title">权益与好物</view>
      <view class="subtitle">开通报告次数，探索甄好算精选商品</view>
    </view>
    <view class="store-hero-icon">✦</view>
  </view>

  <!-- 权益状态栏 -->
  <view class="value-bar zs-card" wx:if="{{valueState}}">
    <view class="value-item">
      <view class="value-num">{{valueState.reportQuotaBalance || 0}}</view>
      <view class="value-label">报告次数</view>
    </view>
    <view class="value-sep" />
    <view class="value-item">
      <view class="value-num">{{valueState.points.points_balance || 0}}</view>
      <view class="value-label">积 分</view>
    </view>
    <view class="value-sep" />
    <view class="value-item">
      <view class="value-num value-level">{{valueState.points.growth_level || '启蒙'}}</view>
      <view class="value-label">等 级</view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="store-actions">
    <view class="store-action-btn" bindtap="openOrders">
      <view class="store-action-icon">📋</view>
      <view class="store-action-text">订单记录</view>
    </view>
    <view class="store-action-btn" bindtap="openAddress">
      <view class="store-action-icon">📍</view>
      <view class="store-action-text">收货地址</view>
    </view>
  </view>

  <!-- 收货地址选择 -->
  <view class="address-block zs-card" wx:if="{{addressOptions.length}}">
    <view class="address-block-head">
      <view class="address-block-icon">📍</view>
      <view class="address-block-info">
        <view class="address-label">{{selectedAddressLabel || '请选择收货地址'}}</view>
        <view class="address-detail">{{selectedAddressDetail || ''}}</view>
      </view>
      <picker mode="selector" range="{{addressOptions}}" range-key="label" bindchange="selectAddress">
        <view class="address-change-btn">切换</view>
      </picker>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="store-section-title">精选商品</view>
  <view class="product-list">
    <block wx:for="{{products}}" wx:key="sku">
      <view class="product-card product-card-{{index % 2 === 0 ? 'gold' : 'teal'}}">
        <view class="product-card-inner">
          <view class="product-top">
            <view class="product-type-badge">{{item.typeText}}</view>
          </view>
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.entitlement_payload.amount ? '报告次数 ×' + item.entitlement_payload.amount : '专属权益'}}</view>
          <view class="product-bottom">
            <view class="product-price">¥<text class="product-price-num">{{item.priceText}}</text></view>
            <t-button
              theme="primary"
              size="small"
              shape="round"
              loading="{{creating}}"
              disabled="{{creating}}"
              bindtap="buyProduct"
              data-sku="{{item.sku}}"
            >{{creating ? '处理中' : '立即购买'}}</t-button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!products.length && !loading}}" class="empty">暂无可售商品</view>
  <view class="notice">微信支付完成后权益立即到账 · 实物商品支付后进入发货流程</view>

</view>
