.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #fdfcf8;
  color: #24313f;
}

.hero {
  padding: 12rpx 0 28rpx;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 0;
  color: #9a6b22;
}

.title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748b;
}

.legal-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ded8ca;
  border-radius: 8rpx;
  background: #ffffff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
}

.updated {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.section {
  margin-top: 24rpx;
}

.section-heading {
  font-size: 26rpx;
  font-weight: 700;
}

.section-content {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #4b5563;
}

.empty,
.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #f5f0e6;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5c4a30;
}
