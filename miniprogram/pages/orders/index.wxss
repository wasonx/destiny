.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  margin-bottom: 0;
}

.order-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  color: #1a2f4b;
  font-size: 30rpx;
  font-weight: 700;
}

.order-items {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.order-status {
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.order-amount {
  color: #b89150;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 22rpx;
}

.shipment {
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.refund-button {
  margin-top: 20rpx;
  min-height: 78rpx;
}
