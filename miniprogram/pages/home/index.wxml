<view class="page home-page">

  <!-- 顶部 Hero -->
  <view class="home-hero">
    <view class="home-hero-left">
      <view class="home-brand">甄 好 算</view>
      <view class="home-title">今天想看<text class="home-title-em">哪件事</text>？</view>
      <view class="home-subtitle">把问题说清，把参考算准。</view>
    </view>
    <view class="home-hero-badge">
      <view class="badge-symbol">☯</view>
    </view>
  </view>

  <!-- 4个功能入口：2x2 大卡片 -->
  <view class="entry-grid">
    <block wx:for="{{primaryEntries}}" wx:key="id">
      <view
        class="entry-card entry-card-{{item.tone}}"
        data-url="{{item.view}}"
        bindtap="goTo"
      >
        <view class="entry-symbol">{{item.mark}}</view>
        <view class="entry-name">{{item.title}}</view>
        <view class="entry-tag">{{item.subtitle}}</view>
        <view class="entry-arrow">→</view>
      </view>
    </block>
  </view>

  <!-- 快捷入口条 -->
  <view class="quick-bar">
    <view class="quick-item" data-url="/pages/compass/index" bindtap="goTo">
      <view class="quick-icon">🧭</view>
      <view class="quick-label">罗盘</view>
    </view>
    <view class="quick-divider" />
    <view class="quick-item" data-url="/pages/store/index" bindtap="goToTab">
      <view class="quick-icon">✦</view>
      <view class="quick-label">商城</view>
    </view>
    <view class="quick-divider" />
    <view class="quick-item" data-url="/pages/me/index" bindtap="goToTab">
      <view class="quick-icon">◎</view>
      <view class="quick-label">我的</view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="home-notice">内容仅供参考，不构成医疗、投资或重大决策建议。</view>

</view>
