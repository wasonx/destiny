.hero-button {
  width: 320rpx;
  margin: 30rpx auto 0;
}

.login-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.login-title {
  color: #1a2f4b;
  font-size: 30rpx;
  font-weight: 700;
}

.login-desc {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.login-action {
  flex-shrink: 0;
  color: #ffffff;
  background: #4a7c77;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-card {
  margin-bottom: 0;
}

.entry-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.entry-title {
  color: #1a2f4b;
  font-size: 38rpx;
  font-weight: 700;
}

.entry-tag {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.entry-desc {
  color: #6b7280;
  font-size: 28rpx;
  line-height: 1.7;
}

.entry-action {
  color: #4a7c77;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 24rpx;
}
