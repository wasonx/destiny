.home-page {
  padding: 24rpx 28rpx 36rpx;
  background:
    linear-gradient(180deg, rgba(74, 124, 119, 0.08), rgba(253, 252, 248, 0) 360rpx),
    #fdfcf8;
}

.workbench-hero {
  padding: 20rpx 0 22rpx;
}

.hero-top {
  display: block;
}

.hero-copy-block {
  max-width: 560rpx;
}

.brand {
  margin-bottom: 12rpx;
  text-align: left;
}

.hero-title {
  color: #1a2f4b;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.22;
}

.hero-subtitle {
  color: #607086;
  font-size: 27rpx;
  line-height: 1.55;
  margin-top: 14rpx;
}

.hero-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 28rpx;
  border: 1rpx solid rgba(184, 145, 80, 0.3);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(26, 47, 75, 0.07);
}

.hero-panel-main {
  flex: 1;
  min-width: 0;
}

.hero-panel-title {
  color: #1a2f4b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.hero-panel-desc {
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.55;
  margin-top: 8rpx;
}

.hero-button {
  width: 220rpx;
  min-height: 76rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  flex-shrink: 0;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 14rpx 0 18rpx;
}

.section-kicker {
  color: #b89150;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-name {
  color: #1a2f4b;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-top: 4rpx;
}

.section-note {
  color: #8a96a8;
  font-size: 22rpx;
  line-height: 1.4;
}

.primary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.primary-card {
  width: calc((100% - 18rpx) / 2);
  min-height: 260rpx;
  margin-bottom: 0;
  padding: 22rpx 22rpx 22rpx 28rpx;
}

.primary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.entry-mark {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #ffffff;
  background: #4a7c77;
  font-size: 28rpx;
  font-weight: 800;
}

.entry-mark.red {
  background: #c84b31;
}

.entry-mark.gold {
  color: #1a2f4b;
  background: rgba(184, 145, 80, 0.26);
}

.entry-tag {
  max-width: 118rpx;
  min-height: 44rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.entry-title {
  color: #1a2f4b;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.22;
}

.entry-desc {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 14rpx;
}
