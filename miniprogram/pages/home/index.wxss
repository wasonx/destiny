/* 首页样式 — 深色玄学风 */

.home-page {
  padding: 0 28rpx 60rpx;
  background:
    radial-gradient(ellipse at 80% 0%, rgba(201, 168, 76, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at 20% 100%, rgba(74, 124, 119, 0.06) 0%, transparent 60%),
    #0C0F1A;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---- Hero ---- */
.home-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 56rpx 0 40rpx;
}

.home-hero-left {
  flex: 1;
  min-width: 0;
}

.home-brand {
  color: #C9A84C;
  font-size: 20rpx;
  letter-spacing: 12rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  opacity: 0.85;
}

.home-title {
  color: #E8EAF0;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.2;
}

.home-title-em {
  color: #C9A84C;
}

.home-subtitle {
  color: #7E8BAA;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}

.home-hero-badge {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 168, 76, 0.08);
  border: 1rpx solid rgba(201, 168, 76, 0.25);
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 24rpx;
  margin-top: 8rpx;
}

.badge-symbol {
  font-size: 44rpx;
  opacity: 0.7;
}

/* ---- 2x2 入口卡片网格 ---- */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.entry-card {
  width: calc((100% - 18rpx) / 2);
  min-height: 236rpx;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(201, 168, 76, 0.15);
  background: #13192B;
  transition: transform 0.15s;
}

.entry-card:active {
  transform: scale(0.97);
}

/* 青绿色调 */
.entry-card-teal {
  background: linear-gradient(145deg, #0E1E1C 0%, #13192B 100%);
  border-color: rgba(74, 124, 119, 0.4);
}
.entry-card-teal::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(74, 124, 119, 0.12);
}

/* 朱红色调 */
.entry-card-red {
  background: linear-gradient(145deg, #1A0E0C 0%, #13192B 100%);
  border-color: rgba(200, 75, 49, 0.35);
}
.entry-card-red::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(200, 75, 49, 0.1);
}

/* 金色调 */
.entry-card-gold {
  background: linear-gradient(145deg, #1A1608 0%, #13192B 100%);
  border-color: rgba(201, 168, 76, 0.35);
}
.entry-card-gold::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(201, 168, 76, 0.1);
}

.entry-symbol {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
  color: rgba(232, 234, 240, 0.15);
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-family: "PingFang SC", serif;
}

.entry-card-teal  .entry-symbol { color: rgba(74, 124, 119, 0.3); }
.entry-card-red   .entry-symbol { color: rgba(200, 75, 49, 0.3); }
.entry-card-gold  .entry-symbol { color: rgba(201, 168, 76, 0.3); }

.entry-name {
  color: #E8EAF0;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  margin-top: 8rpx;
}

.entry-tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 18rpx;
  align-self: flex-start;
}

.entry-card-teal .entry-tag {
  color: #4A7C77;
  background: rgba(74, 124, 119, 0.15);
  border: 1rpx solid rgba(74, 124, 119, 0.3);
}
.entry-card-red .entry-tag {
  color: #C84B31;
  background: rgba(200, 75, 49, 0.1);
  border: 1rpx solid rgba(200, 75, 49, 0.25);
}
.entry-card-gold .entry-tag {
  color: #C9A84C;
  background: rgba(201, 168, 76, 0.1);
  border: 1rpx solid rgba(201, 168, 76, 0.3);
}

.entry-arrow {
  position: absolute;
  bottom: 22rpx;
  right: 24rpx;
  color: rgba(201, 168, 76, 0.5);
  font-size: 28rpx;
}

/* ---- 快捷操作条 ---- */
.quick-bar {
  display: flex;
  align-items: center;
  background: #13192B;
  border: 1rpx solid rgba(201, 168, 76, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 32rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.quick-icon {
  font-size: 36rpx;
  line-height: 1;
}

.quick-label {
  color: #7E8BAA;
  font-size: 22rpx;
  font-weight: 600;
}

.quick-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(201, 168, 76, 0.15);
}

/* ---- 底部声明 ---- */
.home-notice {
  color: #2E3A50;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
  padding: 0 12rpx;
}
