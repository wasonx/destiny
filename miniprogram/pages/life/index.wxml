<view class="page">
  <view class="hero">
    <view class="brand">甄好算 · 照见</view>
    <view class="title">个人节奏参考</view>
    <view class="subtitle">填写基础信息与当前关注方向，生成结构化生活参考报告。</view>
  </view>

  <form bindsubmit="submit">
    <view class="section zs-card">
      <view class="field">
        <text class="label">出生日期</text>
        <picker mode="date" value="{{birthdate}}" bindchange="onBirthDateChange">
          <view class="input" style="color:{{birthdate ? '#1f2329' : '#9aa0a6'}}">{{birthdate || '请选择出生日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">出生时间</text>
        <picker mode="time" value="{{birthtime}}" bindchange="onBirthTimeChange">
          <view class="input" style="color:{{birthtime ? '#1f2329' : '#9aa0a6'}}">{{birthtime || '请选择出生时间（不确定可留空）'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">出生地点</text>
        <input class="input" name="birthplace" placeholder="城市/地区" />
      </view>
      <view class="field">
        <text class="label">当前关注方向</text>
        <view class="chips">
          <block wx:for="{{concerns}}" wx:key="*this">
            <view class="chip {{concern === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setConcern">{{item}}</view>
          </block>
        </view>
      </view>
      <view class="field">
        <text class="label">性别</text>
        <view class="chips">
          <block wx:for="{{genders}}" wx:key="value">
            <view class="chip {{gender === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setGender">{{item.label}}</view>
          </block>
        </view>
      </view>
    </view>

    <view class="section zs-card-gold">
      <view class="field">
        <text class="label">报告版本</text>
        <view class="chips">
          <block wx:for="{{reportTiers}}" wx:key="value">
            <view class="chip {{reportTier === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setReportTier">{{item.label}}</view>
          </block>
        </view>
        <view class="form-help">免费体验版先看摘要，完整版会校验并消耗报告权益。</view>
      </view>
    </view>

    <t-button theme="primary" block form-type="submit" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '正在生成' : '生成个人参考报告'}}
    </t-button>
  </form>

  <view class="notice">你的信息仅用于生成本次参考报告，请避免填写身份证号等敏感信息。</view>
</view>
