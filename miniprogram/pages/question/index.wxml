<view class="page">
  <view class="hero">
    <view class="brand">甄好算 · 问时</view>
    <view class="title">一事一解参考</view>
    <view class="subtitle">尽量只问一件具体的事，系统会给出结构化分析与行动提醒。</view>
  </view>

  <form bindsubmit="submit">
    <view class="section zs-card">
      <view class="field">
        <text class="label">问题方向</text>
        <view class="chips">
          <block wx:for="{{categories}}" wx:key="*this">
            <view class="chip {{category === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setCategory">{{item}}</view>
          </block>
        </view>
      </view>
      <view class="field">
        <text class="label">你想问什么？</text>
        <textarea class="textarea" name="question" placeholder="例如：这个合作机会是否值得继续推进？" />
      </view>
    </view>

    <view class="section zs-card-gold">
      <view class="field">
        <text class="label">报告版本</text>
        <view class="chips">
          <block wx:for="{{reportTiers}}" wx:key="value">
            <view class="chip {{reportTier === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setReportTier">{{item.label}}</view>
          </block>
        </view>
        <view class="form-help">免费体验版先看摘要，完整版会校验并消耗报告权益。</view>
      </view>
    </view>

    <t-button theme="primary" block form-type="submit" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '正在生成' : '提交并生成分析'}}
    </t-button>
  </form>

  <view class="notice">同一件事不宜频繁问。建议在事情出现新变化，或间隔 1-2 周后再问。</view>
</view>
