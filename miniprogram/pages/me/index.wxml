<view class="page me-page">
  <view class="me-hero">
    <view>
      <view class="brand">甄算 · 我的</view>
      <view class="title">客户中心</view>
      <view class="subtitle">查看报告、订单、收货地址和权益积分。</view>
    </view>
    <view class="account-badge {{hasToken ? 'active' : ''}}">{{hasToken ? '已登录' : '未登录'}}</view>
  </view>

  <view class="section account-card zs-card-teal">
    <view class="account-title">{{hasToken ? '甄算客户账号' : '登录后查看权益'}}</view>
    <view class="account-desc">{{hasToken ? '你的报告权益和积分会在这里汇总。' : '支持微信登录，也可以进入登录页使用手机验证码。'}}</view>
    <view class="account-actions" wx:if="{{!hasToken}}">
      <button class="teal-button account-button" type="default" bindtap="loginWithWechat" loading="{{loading}}" disabled="{{loading}}">微信登录</button>
      <button class="ghost-button account-button" type="default" bindtap="openLogin">手机验证码</button>
    </view>
  </view>

  <view class="metric-grid">
    <view class="metric-card">
      <view class="metric-value">{{reportQuota}}</view>
      <view class="metric-label">报告次数</view>
    </view>
    <view class="metric-card">
      <view class="metric-value">{{pointsBalance}}</view>
      <view class="metric-label">积分余额</view>
    </view>
    <view class="metric-card">
      <view class="metric-value level">{{growthLevel}}</view>
      <view class="metric-label">会员等级</view>
    </view>
  </view>

  <view class="section menu-card zs-card">
    <view class="section-title">常用功能</view>
    <view class="menu-row" bindtap="openReports">
      <view>
        <view class="menu-title">报告历史</view>
        <view class="menu-desc">查看已生成的参考报告</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="openOrders">
      <view>
        <view class="menu-title">我的订单</view>
        <view class="menu-desc">查看支付、发货与退款进度</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="openAddress">
      <view>
        <view class="menu-title">收货地址</view>
        <view class="menu-desc">管理实物商品收货信息</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="openStore">
      <view>
        <view class="menu-title">购买权益</view>
        <view class="menu-desc">进入商城购买报告次数或实物商品</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="section menu-card zs-card">
    <view class="section-title">服务说明</view>
    <view class="menu-row last" bindtap="openLegal">
      <view>
        <view class="menu-title">协议与隐私</view>
        <view class="menu-desc">查看用户协议、隐私政策与风险边界</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
