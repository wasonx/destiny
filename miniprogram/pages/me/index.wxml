<view class="page me-page">

  <!-- 顶部用户区域 -->
  <view class="me-header">
    <view class="me-avatar">
      <view class="me-avatar-inner">{{hasToken ? '甄' : '?'}}</view>
      <view class="me-avatar-ring" />
    </view>
    <view class="me-user-info">
      <view class="me-username">{{hasToken ? '甄好算客户' : '未登录'}}</view>
      <view class="me-status-badge {{hasToken ? 'badge-active' : 'badge-inactive'}}">
        {{hasToken ? '✓ 已登录' : '● 未登录'}}
      </view>
    </view>
  </view>

  <!-- 未登录：登录区域 -->
  <view class="login-card zs-card" wx:if="{{!hasToken}}">
    <view class="login-card-text">登录后查看报告次数、订单与积分</view>
    <view class="login-buttons">
      <t-button theme="primary" size="medium" block loading="{{loading}}" disabled="{{loading}}" bindtap="loginWithWechat">微信一键登录</t-button>
      <t-button theme="default" variant="outline" size="medium" block bindtap="openLogin">手机验证码</t-button>
    </view>
  </view>

  <!-- 已登录：权益数据 -->
  <view class="stat-row" wx:if="{{hasToken}}">
    <view class="stat-item">
      <view class="stat-num">{{reportQuota}}</view>
      <view class="stat-label">报告次数</view>
    </view>
    <view class="stat-sep" />
    <view class="stat-item">
      <view class="stat-num">{{pointsBalance}}</view>
      <view class="stat-label">积 分</view>
    </view>
    <view class="stat-sep" />
    <view class="stat-item">
      <view class="stat-num stat-level">{{growthLevel}}</view>
      <view class="stat-label">等 级</view>
    </view>
  </view>

  <!-- 常用功能菜单 -->
  <view class="menu-card zs-card">
    <view class="menu-title">常用功能</view>
    <view class="menu-item" bindtap="openReports">
      <view class="menu-item-left">
        <view class="menu-icon menu-icon-teal">📄</view>
        <view>
          <view class="menu-item-name">报告历史</view>
          <view class="menu-item-desc">查看已生成的参考报告</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="openOrders">
      <view class="menu-item-left">
        <view class="menu-icon menu-icon-gold">🧾</view>
        <view>
          <view class="menu-item-name">我的订单</view>
          <view class="menu-item-desc">支付、发货与退款进度</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="openAddress">
      <view class="menu-item-left">
        <view class="menu-icon menu-icon-teal">📍</view>
        <view>
          <view class="menu-item-name">收货地址</view>
          <view class="menu-item-desc">管理实物商品收货信息</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item menu-item-last" bindtap="openStore">
      <view class="menu-item-left">
        <view class="menu-icon menu-icon-gold">✦</view>
        <view>
          <view class="menu-item-name">购买权益</view>
          <view class="menu-item-desc">商城：报告次数与精选好物</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 服务说明菜单 -->
  <view class="menu-card zs-card">
    <view class="menu-title">关于</view>
    <view class="menu-item menu-item-last" bindtap="openLegal">
      <view class="menu-item-left">
        <view class="menu-icon menu-icon-dim">📜</view>
        <view>
          <view class="menu-item-name">协议与隐私</view>
          <view class="menu-item-desc">用户协议、隐私政策与风险边界</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-area" wx:if="{{hasToken}}">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>

</view>
