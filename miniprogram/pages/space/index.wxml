<view class="page">
  <view class="hero">
    <view class="brand">甄好算 · 安居</view>
    <view class="title">空间环境参考</view>
    <view class="subtitle">填写空间信息与关注问题，生成居住或办公环境调整建议。</view>
  </view>

  <form bindsubmit="submit">
    <view class="section zs-card">
      <view class="field">
        <text class="label">空间类型</text>
        <view class="chips">
          <block wx:for="{{spaceTypes}}" wx:key="*this">
            <view class="chip {{spaceType === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setSpaceType">{{item}}</view>
          </block>
        </view>
      </view>
      <view class="field">
        <text class="label">城市或区域</text>
        <input class="input" name="area" placeholder="例如：成都高新区" />
      </view>
      <view class="field">
        <text class="label">房屋朝向</text>
        <input class="input" name="direction" placeholder="坐北朝南，或点下方罗盘测量" value="{{direction}}" />
        <t-button theme="light" size="small" variant="outline" bindtap="openCompass">打开电子罗盘</t-button>
      </view>
      <view class="field">
        <text class="label">入户门位置</text>
        <input class="input" name="entrance" placeholder="例如：西南侧" />
      </view>
      <view class="field">
        <text class="label">当前最想改善的问题</text>
        <textarea class="textarea" name="question" placeholder="例如：睡眠不好、客厅动线乱、办公室协作效率低" />
      </view>
    </view>

    <view class="section zs-card">
      <view class="field">
        <text class="label">分析重点</text>
        <view class="chips">
          <block wx:for="{{focusOptions}}" wx:key="*this">
            <view class="chip {{focus === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setFocus">{{item}}</view>
          </block>
        </view>
      </view>
      <t-button theme="default" variant="outline" type="default" bindtap="choosePhotos" disabled="{{uploading}}">
        <block wx:if="{{photos.length}}">已选择 {{photos.length}}/{{maxPhotos}} 张照片</block>
        <block wx:elif="{{uploading}}">上传中…</block>
        <block wx:else>选择环境照片</block>
      </t-button>
      <view wx:if="{{photos.length}}" style="display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx;">
        <view wx:for="{{photos}}" wx:key="*this" data-index="{{index}}" bindtap="removePhoto" style="position:relative;width:120rpx;height:120rpx;">
          <image src="{{item}}" mode="aspectFill" style="width:120rpx;height:120rpx;border-radius:12rpx;" />
          <view style="position:absolute;top:-8rpx;right:-8rpx;width:32rpx;height:32rpx;line-height:32rpx;text-align:center;background:rgba(0,0,0,0.6);color:#fff;border-radius:50%;font-size:24rpx;">×</view>
        </view>
      </view>
    </view>

    <view class="section zs-card-gold">
      <view class="field">
        <text class="label">报告版本</text>
        <view class="chips">
          <block wx:for="{{reportTiers}}" wx:key="value">
            <view class="chip {{reportTier === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setReportTier">{{item.label}}</view>
          </block>
        </view>
        <view class="form-help">免费体验版先看摘要，完整版会校验并消耗报告权益。</view>
      </view>
    </view>

    <t-button theme="primary" block form-type="submit" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '正在生成' : '生成环境参考报告'}}
    </t-button>
  </form>

  <view class="notice">可隐藏详细门牌号，资料仅用于生成本次环境参考报告。</view>
</view>
