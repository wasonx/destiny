.login-section {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.privacy-hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4A7C77;
  text-decoration: underline;
}

.login-copy {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.7;
}

.otp-row {
  display: grid;
  grid-template-columns: 1fr 220rpx;
  gap: 18rpx;
  align-items: end;
}

.otp-input {
  min-width: 0;
}

.otp-button {
  min-height: 84rpx;
}

.login-message {
  text-align: center;
}
