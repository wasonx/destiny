<view class="page login-page">
  <view class="hero">
    <view class="brand">甄好算</view>
    <view class="title">客户登录</view>
    <view class="subtitle">登录后可保存报告、查看订单、权益和积分。</view>
  </view>

  <view class="section login-section zs-card-teal">
    <view class="section-title">微信登录</view>
    <view class="login-copy">适合微信内快速进入，登录后可同步报告、订单与权益。</view>
    <t-button theme="primary" block loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="loginWithWechatCode">
      {{loggingIn ? '登录中' : '微信登录'}}
    </t-button>
  </view>

  <view class="section login-section zs-card">
    <view class="section-title">扫码登录</view>
    <view class="login-copy">用于确认电脑端二维码登录，扫码后会把当前微信小程序账号授权给 H5 端。</view>
    <t-button theme="default" variant="outline" block loading="{{scanningQr}}" disabled="{{scanningQr}}" bindtap="scanQrLogin">
      {{scanningQr ? '确认中' : '扫码登录'}}
    </t-button>
  </view>

  <view class="section login-section zs-card">
    <view class="section-title">手机验证码登录</view>
    <view class="login-copy">适合用手机号进入同一客户账号，便于后续查看历史记录。</view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="updatePhone" placeholder="请输入手机号" />
    </view>
    <view class="otp-row">
      <view class="otp-input">
        <text class="label">验证码</text>
        <input class="input" type="number" maxlength="6" value="{{code}}" bindinput="updateCode" placeholder="验证码" />
      </view>
      <t-button theme="default" variant="outline" size="medium" class="otp-button" loading="{{sending}}" disabled="{{sending}}" bindtap="sendPhoneOtp">
        {{sending ? '发送中' : '发送验证码'}}
      </t-button>
    </view>
    <t-button theme="primary" block loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="verifyPhoneOtp">
      手机验证码登录
    </t-button>
  </view>

  <view wx:if="{{message}}" class="message login-message">{{message}}</view>
  <view class="notice">验证码登录为第一版模拟链路，用于验证账号、权益和订单流程，后续可切换腾讯云短信 provider。</view>

  <view class="privacy-hint" bindtap="openLegal">登录即代表已阅读并同意《用户协议与隐私政策》</view>
</view>
