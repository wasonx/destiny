.address-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.address-card {
  border: 1rpx solid rgba(74, 124, 119, 0.28);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.address-card:first-of-type {
  border-top: 0;
}

.address-name {
  color: #1a2f4b;
  font-size: 30rpx;
  font-weight: 700;
}

.address-detail {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}
