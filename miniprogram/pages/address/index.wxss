.address-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.address-card {
  border-top: 1rpx solid #e5e7eb;
  padding: 22rpx 0;
}

.address-card:first-of-type {
  border-top: 0;
}

.address-name {
  color: #1a2f4b;
  font-size: 30rpx;
  font-weight: 700;
}

.address-detail {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.empty {
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
  padding: 36rpx 0;
}
