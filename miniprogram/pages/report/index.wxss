.report-header {
  text-align: left;
}

.history-section {
  padding-bottom: 20rpx;
}

.history-loading,
.history-empty {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.history-card {
  width: 300rpx;
  white-space: normal;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #f9fafb;
  padding: 20rpx;
  box-sizing: border-box;
}

.history-card.active {
  border-color: #4a7c77;
  background: #edf7f5;
}

.history-title {
  color: #1a2f4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.history-meta,
.history-time {
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.report-title {
  color: #1a2f4b;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.report-subtitle,
.report-date,
.source {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.source {
  color: #b89150;
}

.tier-badge {
  display: inline-flex;
  margin: 12rpx 0;
  border: 1rpx solid rgba(184, 145, 80, 0.35);
  border-radius: 10rpx;
  background: rgba(184, 145, 80, 0.12);
  color: #1a2f4b;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

.upgrade-card {
  border-color: rgba(184, 145, 80, 0.35);
  background: rgba(184, 145, 80, 0.08);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tag {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  color: #1a2f4b;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
}

.summary {
  color: #4b5563;
  font-size: 29rpx;
  line-height: 1.8;
}

.point-list {
  margin-top: 18rpx;
}

.point,
.action-item {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.8;
}

.disclaimer {
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}
