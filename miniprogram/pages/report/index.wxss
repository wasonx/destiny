.report-header {
  text-align: left;
}

.history-section {
  padding-bottom: 20rpx;
}

.history-loading,
.history-empty {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.history-card {
  width: 300rpx;
  white-space: normal;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #f9fafb;
  padding: 20rpx;
  box-sizing: border-box;
}

.history-card.active {
  border-color: #4a7c77;
  background: #edf7f5;
}

.history-title {
  color: #1a2f4b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.history-meta,
.history-time {
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.report-title {
  color: #1a2f4b;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.report-subtitle,
.report-date,
.source {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.source {
  color: #b89150;
}

.tier-badge {
  display: inline-flex;
  margin: 12rpx 0;
}

.upgrade-card {
  margin-bottom: 24rpx;
}

.summary-card {
  position: relative;
  overflow: hidden;
}

.summary-card::after {
  content: "";
  position: absolute;
  right: -56rpx;
  top: -56rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(74, 124, 119, 0.08);
}

.report-section-card {
  position: relative;
  overflow: hidden;
  padding-left: 38rpx;
}

.report-section-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #4a7c77;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tag {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  color: #1a2f4b;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
}

.summary {
  color: #4b5563;
  font-size: 29rpx;
  line-height: 1.8;
}

.point-list {
  margin-top: 18rpx;
}

.point {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.8;
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.8;
  margin-top: 18rpx;
}

.action-index {
  flex: 0 0 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(74, 124, 119, 0.12);
  color: #4a7c77;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.action-text {
  flex: 1;
}

.disclaimer {
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.provenance-section {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.provenance-group {
  border-top: 1rpx solid #e5e7eb;
  padding-top: 18rpx;
}

.provenance-title {
  color: #1a2f4b;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.provenance-item,
.provenance-empty {
  background: #f9fafb;
  border-radius: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
}

.provenance-empty {
  color: #9ca3af;
}
